#' Grafik SK bootstrap per kelompok wilayah (metode autoplot untuk sk_wilayah)
autoplot.sk_wilayah <- function(object, urut = c("estimasi", "nama"),
                                tampilkan_n = TRUE, tampilkan_nilai = TRUE,
                                judul = NULL, subjudul = NULL, caption = NULL, ...) {
  validasi_sk_wilayah(object)
  urut <- match.arg(urut)
  d   <- as.data.frame(object$hasil)
  ind <- object$indikator
  
  # urutan dan label kelompok (sama di semua panel)
  rata_est  <- tapply(d$est, d$kelompok, mean)
  n_kel     <- tapply(d$n, d$kelompok, max)
  urutan    <- if (urut == "estimasi") names(sort(rata_est)) else rev(sort(names(rata_est)))
  peta_lab  <- stats::setNames(
    if (tampilkan_n) paste0(names(n_kel), " (n = ", n_kel, ")") else names(n_kel),
    names(n_kel))
  d$label <- factor(unname(peta_lab[as.character(d$kelompok)]),
                    levels = unname(peta_lab[urutan]))
  
  # teks otomatis
  kel_max <- names(which.max(rata_est))
  kel_min <- names(which.min(rata_est))
  judul_oto <- paste(strwrap(
    paste0(.singkat_ind(ind), " tertinggi di ", kel_max, " (", .koma(max(rata_est)),
           "), terendah di ", kel_min, " (", .koma(min(rata_est)), ")"),
    width = 75), collapse = "\n")
  
  subjudul_oto <- if (object$per_tahun) {
    "Satu panel per tahun; SK dihitung terpisah untuk tiap tahun."
  } else {
    tumpang <- .pasangan_tumpang(d)
    if (tumpang == 0) {
      "Tidak ada pasangan kelompok bersebelahan yang SK-nya tumpang tindih."
    } else {
      paste0(tumpang, " dari ", nrow(d) - 1,
             " pasang kelompok bersebelahan: SK tumpang tindih, peringkat belum pasti.")
    }
  }
  
  rt <- object$rentang_tahun
  teks_x <- if (object$per_tahun || is.null(rt)) {
    .label_ind(ind)
  } else {
    paste0(.label_ind(ind), ", rata-rata ", rt[1], "-", rt[2])
  }
  
  caption_oto <- paste0(
    "Titik = rata-rata; garis = SK bootstrap persentil 95% (B = ",
    format(object$B, big.mark = ".", decimal.mark = ","),
    "; unit resample: kabupaten/kota).\n",
    if (any(d$n < 5)) "Kelompok dengan n kecil (n < 5): SK bersifat indikatif.\n" else "",
    "Sumber: BPS, diolah Tim 6.")
  
  g <- ggplot(d, aes(x = est, y = label)) +
    geom_linerange(aes(xmin = bawah, xmax = atas), orientation = "y",
                   color = pal_tim[["garis_utama"]], linewidth = 0.9) +
    geom_point(color = pal_tim[["garis_utama"]], size = 3)
  if (tampilkan_nilai) {
    g <- g + geom_text(aes(label = .koma(est)), vjust = -1.1, size = 3,
                       color = pal_tim[["teks"]])
  }
  g <- g +
    scale_x_continuous(labels = scales::label_number(decimal.mark = ","),
                       expand = expansion(mult = c(0.05, 0.08))) +
    labs(title    = .atur_teks(judul, judul_oto),
         subtitle = .atur_teks(subjudul, subjudul_oto),
         caption  = .atur_teks(caption, caption_oto),
         x = teks_x, y = NULL) +
    theme_tim(grid = "x") +
    theme(plot.title = element_text(size = 13))
  if (object$per_tahun) g <- g + facet_wrap(~ tahun, nrow = 1)
  g
}

