#' Cetak ringkasan objek sk_wilayah
#' print(contoh_sk)
print.sk_wilayah <- function(x, digits = 2, ...) {
  h <- x$hasil
  seed_ok <- length(x$seed) == 1 && !is.na(x$seed)
  cat("Objek analisis tim: SK bootstrap per kelompok wilayah (kelas 'sk_wilayah')\n")
  cat("  Indikator : ", .singkat_ind(x$indikator), "\n", sep = "")
  cat("  Resample  : B = ", format(x$B, big.mark = ".", decimal.mark = ","),
      if (seed_ok) paste0(", seed = ", x$seed) else "", "\n", sep = "")
  if (!is.null(x$rentang_tahun)) {
    cat("  Data      : tahun ", x$rentang_tahun[1], "-", x$rentang_tahun[2],
        if (x$per_tahun) " (SK terpisah tiap tahun)" else " (rata-rata semua tahun per wilayah)",
        "\n", sep = "")
  }
  cat("  Kelompok  : ", length(unique(h$kelompok)), "\n\n", sep = "")
  
  ord <- if (x$per_tahun) order(h$tahun, -h$est) else order(-h$est)
  tab <- data.frame(
    kelompok = as.character(h$kelompok)[ord],
    est      = .koma(h$est[ord], digits),
    bawah    = .koma(h$bawah[ord], digits),
    atas     = .koma(h$atas[ord], digits),
    n        = h$n[ord],
    stringsAsFactors = FALSE
  )
  if (x$per_tahun) tab <- cbind(tahun = h$tahun[ord], tab)
  print(tab, row.names = FALSE)
  invisible(x)
}

#' Ringkasan analisis objek sk_wilayah
#' summary(contoh_sk)
summary.sk_wilayah <- function(object, ...) {
  h <- object$hasil
  rata <- tapply(h$est, h$kelompok, mean)
  if (object$per_tahun) {
    bagi    <- split(h, h$tahun)
    tumpang <- vapply(bagi, .pasangan_tumpang, integer(1))
    pasang  <- vapply(bagi, function(z) nrow(z) - 1L, integer(1))
  } else {
    tumpang <- .pasangan_tumpang(h)
    pasang  <- nrow(h) - 1L
  }
  out <- list(indikator = object$indikator, per_tahun = object$per_tahun,
              n_kelompok = length(rata),
              tertinggi = names(which.max(rata)), est_tertinggi = max(rata),
              terendah = names(which.min(rata)), est_terendah = min(rata),
              tumpang = tumpang, pasangan = pasang,
              n_kecil = unique(as.character(h$kelompok[h$n < 5])))
  class(out) <- "summary.sk_wilayah"
  out
}

#' @rdname summary.sk_wilayah
print.summary.sk_wilayah <- function(x, ...) {
  cat("Ringkasan SK bootstrap ", .singkat_ind(x$indikator), "\n", sep = "")
  cat("  Jumlah kelompok     : ", x$n_kelompok, "\n", sep = "")
  cat("  Rata-rata tertinggi : ", x$tertinggi, " (", .koma(x$est_tertinggi), ")\n", sep = "")
  cat("  Rata-rata terendah  : ", x$terendah, " (", .koma(x$est_terendah), ")\n", sep = "")
  if (x$per_tahun) {
    cat("  SK tumpang tindih (pasangan bersebelahan), per tahun:\n")
    for (th in names(x$tumpang)) {
      cat("    ", th, ": ", x$tumpang[[th]], " dari ", x$pasangan[[th]], "\n", sep = "")
    }
  } else {
    cat("  SK tumpang tindih   : ", x$tumpang, " dari ", x$pasangan,
        " pasang kelompok bersebelahan\n", sep = "")
  }
  if (length(x$n_kecil) > 0) {
    cat("  n kecil (n < 5)     : ", paste(x$n_kecil, collapse = ", "),
        " -> SK bersifat indikatif\n", sep = "")
  }
  invisible(x)
}

