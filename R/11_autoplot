# ---- fungsi bantu internal ---------------------------------------------------
.koma <- function(x, d = 2) {
  format(round(x, d), nsmall = d, decimal.mark = ",", trim = TRUE)
}
.singkat_ind <- function(nama) {
  if (nama %in% c("tpt", "rls")) toupper(nama) else nama
}
.label_ind <- function(nama) {
  switch(nama, tpt = lab_tpt, rls = lab_rls, nama)   # label baku tema tim
}
# NULL = teks otomatis; NA = tanpa teks; selain itu dipakai apa adanya
.atur_teks <- function(x, otomatis) {
  if (is.null(x)) otomatis else if (length(x) == 1 && is.na(x)) NULL else x
}
# jumlah pasangan kelompok bersebelahan (urut menurut estimasi) yang SK-nya tumpang tindih
.pasangan_tumpang <- function(d) {
  if (nrow(d) < 2) return(0L)
  d <- d[order(d$est), ]
  as.integer(sum(d$atas[-nrow(d)] >= d$bawah[-1]))
}

