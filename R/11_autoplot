#' Pemeriksa isi objek sk_wilayah
#'
#' Memastikan objek memuat komponen dan kolom yang dibutuhkan, dan bahwa
#' estimasi berada di dalam selang kepercayaannya. Berhenti dengan pesan jelas
#' bila ada yang tidak sesuai.

#' validasi_sk_wilayah(contoh_sk)
validasi_sk_wilayah <- function(x) {
  if (!is.list(x) || !all(c("hasil", "indikator", "B", "per_tahun") %in% names(x))) {
    stop("Objek sk_wilayah harus memuat: hasil, indikator, B, per_tahun.", call. = FALSE)
  }
  if (!is.character(x$indikator) || length(x$indikator) != 1) {
    stop("indikator harus satu nama kolom (teks), mis. \"tpt\".", call. = FALSE)
  }
  h <- x$hasil
  if (!is.data.frame(h) || nrow(h) == 0) {
    stop("hasil harus tabel (data.frame) yang tidak kosong.", call. = FALSE)
  }
  hilang <- setdiff(c("kelompok", "est", "bawah", "atas", "n"), names(h))
  if (length(hilang) > 0) {
    stop("Kolom pada hasil tidak lengkap, kurang: ", paste(hilang, collapse = ", "),
         call. = FALSE)
  }
  if (isTRUE(x$per_tahun) && !"tahun" %in% names(h)) {
    stop("per_tahun = TRUE membutuhkan kolom 'tahun' pada hasil.", call. = FALSE)
  }
  if (anyNA(h[c("est", "bawah", "atas")])) {
    stop("est, bawah, dan atas tidak boleh berisi nilai kosong.", call. = FALSE)
  }
  if (any(h$bawah > h$est | h$est > h$atas)) {
    stop("Estimasi harus berada di dalam SK (bawah <= est <= atas).", call. = FALSE)
  }
  if (!is.numeric(x$B) || length(x$B) != 1 || x$B < 1999) {
    warning("B kurang dari 1.999 (ketentuan lembar tugas: B >= 1.999).", call. = FALSE)
  }
  invisible(x)
}

#' Buat objek analisis sk_wilayah
#' autoplot(sk)
sk_wilayah <- function(hasil, indikator, B, per_tahun = FALSE,
                       rentang_tahun = NULL, seed = NA) {
  hasil <- as.data.frame(hasil)
  if (is.null(rentang_tahun) && "tahun" %in% names(hasil)) {
    rentang_tahun <- range(hasil$tahun)
  }
  obj <- structure(
    list(hasil = hasil, indikator = as.character(indikator), B = B,
         per_tahun = isTRUE(per_tahun), rentang_tahun = rentang_tahun, seed = seed),
    class = "sk_wilayah"
  )
  validasi_sk_wilayah(obj)
  obj
}

#' Bungkus hasil hitung_sk() menjadi objek sk_wilayah
#' sk <- as_sk_wilayah(hitung_sk(d_sk, tpt))
as_sk_wilayah <- function(x) {
  if (inherits(x, "sk_wilayah")) {
    validasi_sk_wilayah(x)
    return(x)
  }
  if (!is.list(x) || is.null(x$hasil)) {
    stop("x harus daftar hasil hitung_sk() yang memuat komponen 'hasil'.", call. = FALSE)
  }
  sk_wilayah(hasil = x$hasil, indikator = x$indikator, B = x$B,
             per_tahun = isTRUE(x$per_tahun), rentang_tahun = x$rentang_tahun,
             seed = if (is.null(x$seed)) NA else x$seed)
}

